# Copier ce fichier en .env puis adapter les valeurs.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nom_de_votre_base_de_donnees

# --- Datasets ---
# Dossier du serveur qui contient les datasets (chemin absolu)
DATASETS_PATH=/mnt/lslteam/SIIRI/CodePythonSIIRI/

# --- Fichiers écrits par le worker et lus par l'application ---
# Dossier qui contient suivi_patching/ et entrainements/ (facultatif).
# Par défaut : la racine du projet.
# DOSSIER_DONNEES_APP=/chemin/vers/un/dossier

# --- MLflow ---
# Adresse utilisée par le worker pour parler à MLflow
MLFLOW_URL_INTERNE=http://127.0.0.1:5000
# Adresse ouverte dans le navigateur de l'utilisateur (lien dans l'interface).
# À remplacer par l'adresse du serveur, par exemple http://nom-du-serveur:5000
# Par défaut : la même que MLFLOW_URL_INTERNE.
# MLFLOW_URL_PUBLIQUE=http://nom-du-serveur:5000
# 1 : le worker démarre MLflow lui-même. 0 : MLflow est lancé à part.
MLFLOW_DEMARRAGE_AUTO=1
